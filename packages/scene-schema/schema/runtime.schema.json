{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://baron.dev/kline-scene/runtime.schema.json",
  "title": "RuntimeIdentity",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "engine",
    "engineVersion",
    "runtimeVersion"
  ],
  "properties": {
    "engine": {
      "const": "klinecharts"
    },
    "engineVersion": {
      "const": "10.0.0"
    },
    "runtimeVersion": {
      "enum": [
        "0.1.0",
        "0.2.0"
      ]
    }
  }
}
